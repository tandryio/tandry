{
  "name": "@tandryio/client-pi",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/package-plugins.mjs client pi",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@tandryio/bridge": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@tandryio/hub": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "4.23.13",
    "typebox": "1.3.7"
  },
  "pi": {
    "extensions": [
      "./dist/index.cjs"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "Apache-2.0",
  "description": "Tandry messaging for Pi agent conversations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tandryio/tandry.git",
    "directory": "clients/pi"
  },
  "homepage": "https://tandry.io",
  "publishConfig": {
