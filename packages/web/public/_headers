# Read by Workers Static Assets from the built client directory.
# The rule is the file name: a name that changes with its content may be kept
# forever, a name that outlives its content may not.

# Vite writes the content hash into every name under assets/, fonts included.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Copied from public/ under their own names, so a new logo keeps the old path.
/brand/*
  Cache-Control: public, max-age=3600
/hosts/*
  Cache-Control: public, max-age=3600
/host-icons/*
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=3600
/logo.svg
  Cache-Control: public, max-age=3600
