{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandry-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "tandry-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "tandry-avatars"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://127.0.0.1:4173",
    "ROOM_LIMIT": "unlimited",
    "MEMBERS_PER_ROOM": "50",
    "RETENTION_DAYS": "30"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TeamRoom"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "TeamRoom"
      ],
      "new_sqlite_classes": [
        "RoomDO"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
