{
  "name": "@tandryio/website",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tandryio/web build && vite --host 127.0.0.1 --port 4173",
    "build": "pnpm --filter @tandryio/web build && vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "node ../scripts/self-host.mjs deploy-website",
    "types": "wrangler types"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "@tandryio/protocol": "workspace:*",
    "@tandryio/web": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tandryio/tandry.git",
    "directory": "website"
  },
  "private": true
}
