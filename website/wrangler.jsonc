{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandry-website",
  "main": "./src/server.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "services": [
    {
      "binding": "ROOM_HUB",
      "service": "tandry-hub"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
